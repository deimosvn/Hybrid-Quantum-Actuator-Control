<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quantum_rover_interfaces</name>
  <version>1.0.0</version>
  <description>
    Custom message, service and action interfaces for the Hybrid
    Quantum-Classical Rover Actuator Control stack (telemetry, control-mode
    switching, single-shot optimization and velocity-profile benchmarking).
  </description>

  <maintainer email="diego.martinez111213@gmail.com">Diego Eduardo Martinez Cruz</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/deimosvn/Hybrid-Quantum-Actuator-Control</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
