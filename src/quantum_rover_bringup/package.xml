<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quantum_rover_bringup</name>
  <version>1.0.0</version>
  <description>
    Top-level launch files and configuration that orchestrate the full quantum
    rover stack (simulator, lifecycle controller, telemetry logger and RViz).
  </description>

  <maintainer email="diego.martinez111213@gmail.com">Diego Eduardo Martinez Cruz</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/deimosvn/Hybrid-Quantum-Actuator-Control</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>quantum_rover_control</exec_depend>
  <exec_depend>quantum_rover_description</exec_depend>
  <exec_depend>quantum_rover_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
